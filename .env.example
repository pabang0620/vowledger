# Leave the keys empty to run on the built-in mock PayPal. The sample contracts then replay real Claude Sonnet runs recorded on 2026-11-12; other text uses the rule-based agent.
PORT=3002

# PayPal Sandbox REST app (Invoicing v2). Sandbox only: the code talks to api-m.sandbox.paypal.com.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: id of a sandbox webhook subscribed to INVOICING.INVOICE.* events, used to verify signatures.
PAYPAL_WEBHOOK_ID=

# The first milestone (deposit) is paid through a PayPal Orders checkout. 0 puts it back on an invoice.
DEPOSIT_CHECKOUT=1
# Public base URL of this app: PayPal sends the payer back to APP_BASE_URL/api/deposit/return (default http://localhost:PORT).
APP_BASE_URL=

# Claude reads contracts and picks scheduling options. Without a key, recorded runs (samples) or a rule-based reader and agent run instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Local development only: run the model through your own Claude Code login instead of an API key (the key is never used).
# Needs the Claude Code CLI signed in. The model is ANTHROPIC_MODEL. Leave empty for the rule-based agent.
LLM_BACKEND=

# Milliseconds between invoice polls (default 5000). The poll is the second entrance after webhooks.
POLL_INTERVAL_MS=5000

# Shown to judges in the demo controls when set (sandbox buyer account, fake money only).
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# Set to 1 to ignore every key above and run fully on mocks.
FORCE_MOCK=0
# Set to 1 to keep PayPal on the built-in mock while the model runs (for example LLM_BACKEND=account).
FORCE_MOCK_PAYPAL=0
